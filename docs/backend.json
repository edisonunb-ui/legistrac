
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "perfil": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "ASSESSOR", "ESTAGIARIO"] },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["uid", "nome", "email", "perfil"]
    },
    "Demand": {
      "title": "Demand",
      "description": "A cabinet demand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "criadoPor": { "type": "string" },
        "responsavelAtual": { "type": "string" },
        "status": { "type": "string", "enum": ["ABERTO", "EM_ANDAMENTO", "AGUARDANDO_VEREADORA", "FINALIZADO"] },
        "prazo": { "type": "string" },
        "prioridade": { "type": "string", "enum": ["BAIXA", "MEDIA", "ALTA"] },
        "liderancaId": { "type": "string" },
        "atendimentoId": { "type": "string" }
      }
    },
    "CitizenService": {
      "title": "CitizenService",
      "description": "Citizen service record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "municipeNome": { "type": "string" },
        "municipeEndereco": { "type": "string" },
        "municipeTituloEleitoral": { "type": "string" },
        "municipeTelefone": { "type": "string" },
        "descricaoSolicitacao": { "type": "string" },
        "dataAtendimento": { "type": "object" },
        "atendidoPor": { "type": "string" },
        "demandaId": { "type": "string" }
      }
    },
    "Leader": {
      "title": "Leader",
      "description": "Political base leader",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "bairro": { "type": "string" },
        "contato": { "type": "string" },
        "potencialVotos": { "type": "number" },
        "influencia": { "type": "string", "enum": ["BAIXA", "MEDIA", "ALTA"] },
        "status": { "type": "string", "enum": ["ATIVO", "PROSPECTO", "INATIVO"] }
      }
    },
    "Territory": {
      "title": "Territory",
      "description": "Territorial base management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bairro": { "type": "string" },
        "metaVotos": { "type": "number" },
        "votosAtuais": { "type": "number" }
      }
    },
    "GlobalConfig": {
      "title": "GlobalConfig",
      "description": "Global system configurations",
      "type": "object",
      "properties": {
        "metaVotos2026": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/demandas/{demandaId}": {
      "schema": "Demand",
      "description": "Cabinet demands"
    },
    "/atendimentos/{atendimentoId}": {
      "schema": "CitizenService",
      "description": "Citizen service records"
    },
    "/liderancas/{leaderId}": {
      "schema": "Leader",
      "description": "Political leaders"
    },
    "/territorios/{territoryId}": {
      "schema": "Territory",
      "description": "Territorial data"
    },
    "/config/{configId}": {
      "schema": "GlobalConfig",
      "description": "System settings"
    }
  }
}
