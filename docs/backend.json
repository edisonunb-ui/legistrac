
{
  "entities": {
    "Cabinet": {
      "title": "Cabinet",
      "description": "A political cabinet (Vereador)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "vereador": { "type": "string" },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["nome", "vereador"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "perfil": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "ASSESSOR", "ESTAGIARIO"] },
        "cabinetId": { "type": "string" },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["uid", "nome", "email", "perfil"]
    },
    "Demand": {
      "title": "Demand",
      "description": "A cabinet demand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cabinetId": { "type": "string" },
        "titulo": { "type": "string" },
        "descricao": { "type": "string" },
        "criadoPor": { "type": "string" },
        "responsavelAtual": { "type": "string" },
        "status": { "type": "string", "enum": ["ABERTO", "EM_ANDAMENTO", "AGUARDANDO_VEREADORA", "FINALIZADO"] },
        "prazo": { "type": "string" },
        "prioridade": { "type": "string", "enum": ["BAIXA", "MEDIA", "ALTA"] }
      }
    },
    "CitizenService": {
      "title": "CitizenService",
      "description": "Citizen service record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cabinetId": { "type": "string" },
        "municipeNome": { "type": "string" },
        "municipeEndereco": { "type": "string" },
        "municipeTelefone": { "type": "string" },
        "descricaoSolicitacao": { "type": "string" }
      }
    },
    "Leader": {
      "title": "Leader",
      "description": "Political base leader",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cabinetId": { "type": "string" },
        "nome": { "type": "string" },
        "bairro": { "type": "string" },
        "potencialVotos": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/gabinetes/{cabinetId}": {
      "schema": "Cabinet",
      "description": "Cabinets list"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/demandas/{demandaId}": {
      "schema": "Demand",
      "description": "Cabinet demands"
    },
    "/atendimentos/{atendimentoId}": {
      "schema": "CitizenService",
      "description": "Citizen service records"
    },
    "/liderancas/{leaderId}": {
      "schema": "Leader",
      "description": "Political leaders"
    }
  }
}
