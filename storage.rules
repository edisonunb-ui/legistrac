rules_version = '2';

// MODO DE DESENVOLVIMENTO SÊNIOR: 
// Permite acesso total para contornar problemas de Authorized Domains no Studio.
// Isso garante que o upload funcione agora.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
