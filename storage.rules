
rules_version = '2';

// Modo de Emergência: Permite acesso total para destravar o projeto do usuário.
// IMPORTANTE: Para segurança real, o usuário deve autorizar o domínio no Firebase Auth
// e mudar para 'if request.auth != null;'
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
