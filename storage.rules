rules_version = '2';

// MODO DE DESENVOLVIMENTO SÊNIOR: 
// Permite acesso total para contornar problemas de Authorized Domains no Studio.
// IMPORTANTE: Aplique isso no projeto "legistrac" no console do Firebase.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}