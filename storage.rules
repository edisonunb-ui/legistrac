
rules_version = '2';

// SOLUÇÃO DEFINITIVA: Apenas usuários logados podem ler e escrever.
// Requer que o domínio do site esteja na lista de "Authorized Domains" no Firebase Auth.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
