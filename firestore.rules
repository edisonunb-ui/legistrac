rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita para qualquer usuário autenticado em qualquer coleção.
    // Essencial para o funcionamento do sistema de demandas e trâmites.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}