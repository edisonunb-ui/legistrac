rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita para qualquer usuário autenticado em qualquer coleção.
    // Isso resolve o conflito entre 'demands' e 'demandas' e libera o acesso para a Ana.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}