rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "edisonunb@gmail.com" || 
        request.auth.token.email == "gabinete.professoraflavia@gmail.com"
      );
    }
    
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.perfil == "ADMIN" || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.perfil == "SUPER_ADMIN")
      );
    }

    match /users/{userId} {
      // Todos podem ler a lista de usuários para atribuir demandas
      allow read: if isAuthenticated();
      // Criar usuário: Qualquer um logado (no onboarding) ou Admin
      allow create: if isAuthenticated();
      // Atualizar/Deletar: Apenas o próprio usuário ou Admin
      allow update, delete: if isSuperAdmin() || isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /demandas/{demandaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.responsavelAtual == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /tramites/{tramiteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /notificacoes/{notificacaoId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}