rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Função básica de autenticação
    function isSignedIn() {
      return request.auth != null;
    }

    // Master Admin com acesso total (edisonunb@gmail.com)
    function isMasterAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == "edisonunb@gmail.com";
    }

    // Regras para perfis de usuários
    match /users/{userEmail} {
      allow read: if isSignedIn();
      allow write: if isMasterAdmin() || (isSignedIn() && request.auth.token.email.lower() == userEmail.lower());
    }

    // Coleções operacionais: Acesso permitido para qualquer membro autenticado do gabinete
    match /demandas/{docId} {
      allow read, write: if isSignedIn();
    }

    match /tramites/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notificacoes/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}