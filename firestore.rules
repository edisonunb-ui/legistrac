rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função Senior: Obtém o email de forma segura de múltiplas fontes no token
    function getEmail() {
      return request.auth.token.email != null ? request.auth.token.email : 
             (request.auth.token.firebase.identities.email != null ? request.auth.token.firebase.identities.email[0] : null);
    }

    // Função Master: Verifica o e-mail mestre com tolerância a nulos e caixa alta/baixa
    function isMasterAdmin() {
      let email = getEmail();
      return request.auth != null && email != null && 
             (email.lower() == "edisonunb@gmail.com" || email.lower() == "gabinete.professoraflavia@gmail.com");
    }
    
    // Regra de Ouro: O Master Admin tem acesso TOTAL e IRRESTRITO a tudo
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras de Usuários: Permite que qualquer logado leia a lista, mas só o Master ou o dono escreva
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        isMasterAdmin() || 
        (getEmail() != null && getEmail().lower() == userEmail.lower())
      );
    }

    // Regras Gerais: Equipe autenticada pode operar no sistema
    match /demandas/{demandaId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{tramiteId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
  }
}