rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário é um dos administradores mestres
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             (
               request.auth.token.email.lower() == "edisonunb@gmail.com" || 
               request.auth.token.email.lower() == "gabinete.professoraflavia@gmail.com"
             );
    }
    
    // Regra Global: Master Admin tem permissão total em qualquer coleção
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras específicas para a coleção de usuários
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        isMasterAdmin() || 
        request.auth.token.email.lower() == userEmail.lower()
      );
    }

    // Regras para demandas e trâmites (acesso para equipe autenticada)
    match /demandas/{demandaId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{tramiteId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
  }
}