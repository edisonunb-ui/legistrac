rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se é um dos e-mails mestres do projeto
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "edisonunb@gmail.com" || 
        request.auth.token.email == "gabinete.professoraflavia@gmail.com"
      );
    }
    
    // Regra Global: Se for o Master Admin, permite TUDO em qualquer coleção
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras de fallback para outros usuários autenticados
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && (request.auth.token.email == userEmail || isMasterAdmin());
    }

    match /demandas/{demandaId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{tramiteId} {
      allow read, create: if request.auth != null;
    }

    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
  }
}