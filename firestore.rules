rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite acesso total para o email do SuperAdmin
    match /{document=**} {
      allow read, write: if request.auth != null && 
                          request.auth.token.email.lower() == "edisonunb@gmail.com";
    }

    // Regras gerais para usuários autenticados
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.lower() == userEmail.lower();
    }

    match /demandas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
