rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Verifica se o usuário está autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se é o administrador mestre
    function isMasterAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == "edisonunb@gmail.com";
    }

    // Acesso total para o SuperAdmin em qualquer documento
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras para perfis de usuários
    match /users/{userEmail} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isMasterAdmin() || 
        (request.auth.token.email != null && request.auth.token.email.lower() == userEmail.lower())
      );
    }

    // Regras para demandas, trâmites e notificações
    // Permitimos leitura e escrita para qualquer usuário logado do gabinete
    match /demandas/{docId} {
      allow read, write: if isSignedIn();
    }

    match /tramites/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notificacoes/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}