rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regra mestre: permite leitura e escrita para qualquer usuário autenticado em qualquer coleção.
    // Isso resolve o erro de permissão da Ana e de outros assessores.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}