rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário logado é um Master Admin
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "edisonunb@gmail.com" || 
        request.auth.token.email == "gabinete.professoraflavia@gmail.com"
      );
    }

    // Regra Global: Master Admins podem TUDO
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras Específicas para Usuários
    match /users/{userEmail} {
      allow read: if request.auth != null;
      // Permite escrita se for o próprio usuário ou se for admin
      allow write: if request.auth != null && (
        isMasterAdmin() || 
        (request.auth.token.email != null && request.auth.token.email.lower() == userEmail.lower())
      );
    }

    // Regras para Demandas e Trâmites
    match /demandas/{demandaId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{tramiteId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
  }
}