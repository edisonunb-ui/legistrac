rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função ultra-robusta para verificar o SuperAdmin Master
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == "edisonunb@gmail.com";
    }

    // Regra Global: Master Admins têm acesso TOTAL e ABSOLUTO
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras para Usuários (Coleção identificada por Email)
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        isMasterAdmin() || 
        (request.auth.token.email != null && request.auth.token.email.lower() == userEmail.lower())
      );
    }

    // Acesso Geral para usuários autenticados nas outras coleções
    match /demandas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{docId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
