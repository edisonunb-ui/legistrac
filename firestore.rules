rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "edisonunb@gmail.com" || 
        request.auth.token.email == "gabinete.professoraflavia@gmail.com"
      );
    }
    
    // Regra simplificada e robusta para usuários
    match /users/{userEmail} {
      // Qualquer pessoa logada pode ler os perfis (necessário para listar a equipe e atribuir demandas)
      allow read: if isAuthenticated();
      // Apenas SuperAdmins podem criar ou deletar perfis
      allow write: if isSuperAdmin();
      // O próprio usuário pode atualizar seus dados se o e-mail coincidir
      allow update: if isAuthenticated() && request.auth.token.email == userEmail;
    }

    match /demandas/{demandaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    match /tramites/{tramiteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /notificacoes/{notificacaoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}