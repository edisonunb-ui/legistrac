rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Função básica de autenticação
    function isSignedIn() {
      return request.auth != null;
    }

    // Regras para perfis de usuários
    match /users/{userEmail} {
      allow read, write: if isSignedIn();
    }

    // Coleções operacionais: Acesso permitido para qualquer membro autenticado
    match /demandas/{docId} {
      allow read, write: if isSignedIn();
    }

    match /tramites/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notificacoes/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}