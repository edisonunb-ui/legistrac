rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "edisonunb@gmail.com" || 
        request.auth.token.email == "gabinete.professoraflavia@gmail.com"
      );
    }
    
    // Regra de Ouro: SuperAdmin tem poder total sobre tudo
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Regras específicas para outros usuários
    match /users/{userEmail} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.token.email == userEmail;
    }

    match /demandas/{demandaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /tramites/{tramiteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /notificacoes/{notificacaoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }
  }
}