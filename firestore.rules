rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário é o SuperAdmin Master
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "edisonunb@gmail.com" || 
              request.auth.token.email.lower() == "gabinete.professoraflavia@gmail.com");
    }

    // Regra Global: Master Admins têm acesso TOTAL e ABSOLUTO
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras para Usuários
    match /users/{userEmail} {
      allow read: if request.auth != null;
      // Permite escrita se for o próprio usuário ou se for admin mestre
      allow write: if request.auth != null && (
        isMasterAdmin() || 
        (request.auth.token.email != null && request.auth.token.email.lower() == userEmail.lower())
      );
    }

    // Regras para Demandas, Trâmites e Notificações (Acesso para usuários autenticados)
    match /demandas/{demandaId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{tramiteId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
  }
}