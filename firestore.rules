rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para obter o e-mail do token de forma segura (normalizado para minúsculas)
    function getEmail() {
      return request.auth != null && request.auth.token.email != null ? request.auth.token.email.lower() : null;
    }

    // Função Master: Verifica se o usuário é um dos administradores principais
    function isMasterAdmin() {
      let email = getEmail();
      return email != null && (
        email == "edisonunb@gmail.com" || 
        email == "gabinete.professoraflavia@gmail.com"
      );
    }
    
    // Regra de Ouro: O Master Admin tem acesso TOTAL e IRRESTRITO a tudo
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Regras específicas para coleções (Garante redundância e clareza)
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isMasterAdmin() || getEmail() == userEmail.lower());
    }

    match /demandas/{demandaId} {
      allow read, write: if request.auth != null;
    }

    match /tramites/{tramiteId} {
      allow read, write: if request.auth != null;
    }

    match /notificacoes/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
  }
}